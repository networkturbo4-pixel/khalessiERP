<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /khalessierp/

    # Si la petición es para /api/, enviarlo al enrutador PHP
    RewriteRule ^api/(.*)$ api/index.php?request=$1 [QSA,NC,L]

    # Si el archivo o directorio existe físicamente, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Si no existe, enviar todo al Frontend (SPA Container)
    RewriteRule ^(.*)$ index.html [QSA,L]
</IfModule>

# Prevenir que navegadores o proxys retengan versiones antiguas de index.html y sw.js
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|index\.html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

